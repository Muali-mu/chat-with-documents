# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatdocs

# --- API Keys ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GROQ_API_KEY=your-groq-api-key-here

# --- LLM provider switch ---
# "anthropic" = Claude (paid but cheap, best at following the citation rules)
# "groq"      = free, very fast, open-weight models (Llama/Qwen/gpt-oss)
LLM_PROVIDER=groq

# --- Models ---
CLAUDE_MODEL=claude-sonnet-4-6
GROQ_MODEL=llama-3.3-70b-versatile
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_RERANK_MODEL=rerank-2

# --- Chunking ---
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# --- Retrieval ---
VECTOR_TOP_K=25
KEYWORD_TOP_K=25
RERANK_TOP_K=8
